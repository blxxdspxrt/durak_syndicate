# ============================================================================
# Переменные окружения. Скопируйте в .env.local и заполните.
# .env.local НЕ коммитится в git.
# ============================================================================

# Публичный URL проекта Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Публичный anon-ключ (можно держать в браузере, доступ ограничен RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# СЕКРЕТНЫЙ ключ service_role (Settings → API → service_role).
# ОБЯЗАТЕЛЕН для защиты карт и данных. НИКОГДА не публикуйте его
# и не добавляйте в NEXT_PUBLIC_* переменные — только сервер.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Токен Telegram-бота. Без него API не проверяет подпись initData.
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Необязательно. Секрет для фонового «дворника» присутствия
# GET /api/cron/sweep (заголовок Authorization: Bearer <CRON_SECRET>).
# Если не задан — эндпоинт открыт (удобно для локальной отладки).
CRON_SECRET=
